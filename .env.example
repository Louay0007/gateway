# ── Hostnames ────────────────────────────────────────────────────
API_DOMAIN=api.zaino.soon.it
PORTAL_DOMAIN=portal.zaino.soon.it

# Operations console — the staff-facing Next.js admin (suspend accounts,
# verify D17 payments, revenue & margin, plans, staff). IP-gated in
# config/Caddyfile: replace the placeholder IP with yours (curl -s
# ifconfig.me) before first use, or you will lock yourself out.
CONSOLE_DOMAIN=admin.zaino.soon.it

# NOTE: there is deliberately no ADMIN_DOMAIN any more. It used to point
# at LiteLLM's own Admin UI (127.0.0.1:4000), which is a master-key-only
# surface — a different product from the portal console, and far more
# powerful. LiteLLM's management API is now reachable ONLY over an SSH
# tunnel:  ssh -L 4000:localhost:4000 gateway@<VPS_IP>  →  http://localhost:4000/ui
# The same pattern the Caddyfile already uses for `opencode web`.
# Web terminal (opencode web via systemd). Needs DNS: code A <VPS_IP>.
# The Caddy block is IP-gated — replace the placeholder IP in
# config/Caddyfile with yours (curl ifconfig.me) before use.
CODE_DOMAIN=code.zaino.soon.it

# ── Gateway credentials ──────────────────────────────────────────
# MASTER key authorises the management API + Admin UI.
# NEVER issue to a client.     Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=

# SALT encrypts provider credentials stored in Postgres.
# Set ONCE. Changing it makes every stored credential unreadable.
# BACK THIS UP SEPARATELY FROM THE DATABASE DUMP — it is not in the
# pg_dump, and losing it bricks every stored provider credential.
LITELLM_SALT_KEY=

# ── Upstream (the real provider) ─────────────────────────────────
# Run ./scripts/probe-upstream.sh to determine which format this is
# and what the exact resolved URL will be.
#
# ACTIVE DEV UPSTREAM: integrate.api.nvidia.com/v1, serving
# nvidia/nemotron-3.5-super-vl-120b-a12b as `fast` / `smart` / `frontier`.
# NVIDIA NIM is OpenAI-compatible at /v1/chat/completions only — it does
# NOT serve /v1/messages or /v1/responses.
UPSTREAM_BASE_URL=https://integrate.api.nvidia.com/v1
UPSTREAM_API_KEY=

# NVIDIA's base URL already carries /v1, so LiteLLM must NOT append
# another /v1 for anthropic-format paths (→ /v1/v1/messages).
LITELLM_ANTHROPIC_DISABLE_URL_SUFFIX=true

# ── Datastore secrets ────────────────────────────────────────────
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Gateway tuning (not secrets — safe to keep in compose) ──────
# NUM_WORKERS: uvicorn workers. 2 on a 1–2 vCPU box. Queue wait inside a
# single worker is invisible to LiteLLM's own logs (LATENCY.md §4.3.4) —
# a second worker is cheaper than the mystery latency. Raise with vCPUs,
# watching `in_flight_requests` and Postgres connections.
#NUM_WORKERS=2

# ── Portal ────────────────────────────────────────────────────────
# Signs Auth.js session JWTs. Generate: openssl rand -base64 32
# `make init` fills this in. Rotating it signs every user out.
AUTH_SECRET=
# Phase 6+. Test keys until the launch checklist (§9) says otherwise.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...

# ── Billing (D17 manual payments, or the dev provider) ─────────────
# BILLING_PROVIDER: `dev` runs a simulated payment (BILLING_DEV_SECRET
# signs its callbacks so the same code path is exercised end to end);
# `d17` is the real La Poste Tunisienne flow, where staff confirm each
# transfer by hand against customer-submitted proof. See docs/d17-payments.md.
BILLING_PROVIDER=dev
# REQUIRED by docker-compose.yml whenever BILLING_PROVIDER is `dev`, and
# mirrored to both the portal and jobs services so a callback signature
# verifies identically from either side. Must be >= 16 chars.
BILLING_DEV_SECRET=
# How long a D17 payment window stays open before the proof expires.
PAYMENT_WINDOW_HOURS=24
# Shape of a La Poste authorization number; anything else is rejected at
# submit rather than reaching a staff member's queue.
AUTH_NUMBER_REGEX=^[A-Za-z0-9]{4,32}$

# ── D17 transfer settings ─────────────────────────────────────────
# Read by portal/lib/billing/d17.ts and portal/lib/billing/d17-config.ts.
#
# `make verify-d17` ABORTS with "D17_RECEIVER_PHONE is not configured"
# unless these are present. They are deliberately absent from this file's
# defaults: D17_RECEIVER_PHONE is a real merchant number that La Poste
# pays out to, and shipping a placeholder in .env.example invites a deploy
# that looks configured and is not.
#
# Only needed when BILLING_PROVIDER=d17. The dev provider ignores them.
#
# The merchant phone is a real La Poste payout number, so it is NOT given a
# placeholder default: a deploy that carries an empty value fails loudly
# (verify-d17 aborts) instead of quietly paying the wrong account.
D17_RECEIVER_PHONE=
# TND per USD, used to quote the amount a customer must transfer.
D17_USD_TND_RATE=3.1
# How many proofs one phone may submit inside the review window before the
# submission is held for a human instead of auto-approved.
D17_MAX_PROOF_PER_HOUR=3
# Past this many pending proofs the same phone is treated as suspicious.
D17_REVIEW_THRESHOLD=3
D17_REVIEW_WINDOW_MINUTES=60
# Where customer-uploaded proof images land. Must be writable by the portal
# container and excluded from the repo.
D17_UPLOADS_DIR=./_d17_uploads

# ── Email ──────────────────────────────────────────────────────────
# EMAIL_TRANSPORT: `dev` logs the message (and any link) instead of
# sending it. Password reset, email verification and D17 receipts all go
# through this one seam.
EMAIL_TRANSPORT=dev
# RESEND_API_KEY=re_...
MAIL_FROM="Gateway <noreply@localhost>"
# Where anomaly alerts and job failures go. Leave empty to disable.
OPS_ALERT_EMAIL=

# ── Portal URL (absolute; used in emails and OAuth-free redirects) ──
# Must match PORTAL_DOMAIN in production or Auth.js redirects off-host.
APP_URL=http://127.0.0.1:3000

# ── Pinned image tags (update deliberately, review release notes) ─
LITELLM_VERSION=v1.103.1

# ── Admin console gate ─────────────────────────────────────────────
# Shared secret for the operations console entry screen. The gate
# page at /admin asks for this code before rendering anything. Set
# it on the VPS; omitting it disables the gate entirely.
ADMIN_GATE_SECRET=zainadmin
