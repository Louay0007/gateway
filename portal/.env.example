# ── Portal runtime environment (VPS .env only; never in git) ───────
# These are read by the `portal` container. See IMPLEMENTATION.md §5.1.

# Our own Postgres database — NEVER the litellm one. db/index.ts throws
# if this points at `litellm` (PLATFORM.md §1.2).
DATABASE_URL=postgresql://portal:${POSTGRES_PASSWORD}@postgres:5432/portal

# LiteLLM over the internal Docker network. REST ONLY — no SQL against
# the litellm database, ever (PLATFORM.md §1.1).
LITELLM_INTERNAL_URL=http://litellm:4000
LITELLM_MASTER_KEY=

# ── Auth.js / NextAuth (self-hosted; no Clerk) ──────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Canonical origin. Used to build absolute callback URLs; set it to the
# PUBLIC portal URL or redirects after sign-in land on `/`.
AUTH_URL=https://zaino.soon.it
# Only true behind a proxy you control (Caddy).
AUTH_TRUST_HOST=true
# Never enable in production: Auth.js debug LOGS THE POST BODY, which
# includes the submitted password.
AUTH_DEBUG=false

# ── Chat product: the key that seals each org's gateway credential ───
# AES-256-GCM at rest (lib/crypto/sealed.ts). DELIBERATELY NOT derived
# from AUTH_SECRET: rotating the session-signing key must not orphan every
# stored gateway credential, and a leak of one must not yield the other.
# Generate: openssl rand -base64 32   (32 bytes, base64, no passphrase)
# Losing it is recoverable: the sealed value fails to open, the credential
# is re-minted on the next turn (lib/chat/key.ts), and the old gateway key
# is left to expire. Nothing is charged twice.
CHAT_KEY_SECRET=

# ── Pricing (portal reads the SAME table the gateway does) ──────────
PRICE_FILE=/app/prices/models.yaml

# ── App ─────────────────────────────────────────────────────────────
# Public GATEWAY host (Caddy serves the API here). Used only to render the
# quickstart snippet on /dashboard/keys — same value docker-compose gives
# to the caddy service.
API_DOMAIN=api.zaino.soon.it
NEXT_PUBLIC_APP_URL=https://zaino.soon.it
APP_URL=https://zaino.soon.it

# ── Two billing rails ────────────────────────────────────────────────
# Billed per rail; both live at once. See docs/dodo-payments.md.
# D17 (Tunisia, exact dinar asks in plans.price_tnd_millimes):
D17_USD_TND_RATE=3.1
D17_RECEIVER_PHONE=
# Dodo (international, USD; API key + Standard Webhooks signing secret):
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
LITELLM_LOG=ERROR

# ── Phase 6+ (Stripe) ───────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=...
# ── Admin console gate ─────────────────────────────────────────────
# Must match ADMIN_GATE_SECRET in the root .env. Read by the layout
# server component to verify the gate cookie.
ADMIN_GATE_SECRET=zainadmin
