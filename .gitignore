# ── Secrets (never commit) ───────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Backups + exports (contain live data) ────────────────────────────
# Both formats: *.sql.gz was the single-database archive, *.tar.gz is the
# current two-database one. These hold every subscription, key prefix and
# usage record in the business — they must never enter a PUBLIC repo.
backup-*.sql.gz
backup-*.tar.gz
latency.csv

# ── Node / Next.js ───────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
*.log
*.tsbuildinfo
next-env.d.ts
playwright-report/
test-results/
.DS_Store

# ── Local tooling state ──────────────────────────────────────────────
# Editor/agent workspace markers. Machine-local identity, not project
# content, and this repository is public.
.freebuff/
.claude/

# ── Operator scratch (never commit) ───────────────────────────────────
# `_rescue/` holds pg_dump archives of the LIVE portal database plus
# extracted D17 payment evidence — real authorization numbers, sender
# phone numbers, key hashes and the full audit log. The repository is
# PUBLIC, so a `git add -A` here would publish customer and payment data.
# Backups belong off-box; this is a local copy, not project content.
_rescue/

# Screenshots of the running checkout UI. They capture real session state.
*.png

# ── Local data (never commit) ─────────────────────────────────────────
# D17 proof screenshots: user-uploaded images. Local/dev only until the
# VPS path is set; they are served read-only to staff, never publicly.
data/
