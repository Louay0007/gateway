{
	email you@zaino.soon.it

	# ── Every site address is prefixed with {$CADDY_SCHEME:} ──────────
	# Empty on the VPS, so each address stays bare and Caddy gets a
	# certificate and listens on :443, exactly as before this variable
	# existed. Locally (docker-compose.local.yml) it is `http://`, which
	# makes Caddy serve plain HTTP on :80 with NO ACME attempt.
	#
	# This exists because Docker Desktop cannot use host networking: the
	# VPS model (`network_mode: host`, proxy 127.0.0.1:<port> from the
	# host's own loopback) is unreachable from macOS. Rather than fork
	# the config, the parts that differ are variables with prod defaults
	# — see UPSTREAMS below. Three values change locally, and only those.
	#
	# UPSTREAMS, and why each has a default rather than a required value:
	#   {$AUTH_EDGE_UPSTREAM:127.0.0.1:4001}  prod = host loopback
	#   {$PORTAL_UPSTREAM:127.0.0.1:3000}     prod = host loopback
	#   {$CODE_UPSTREAM:127.0.0.1:4096}       prod = host systemd unit
	# A missing variable would expand to an empty string and produce a
	# bare `reverse_proxy {` — so every one of them carries its current
	# production value as the default. If Docker Desktop is ever fixed or
	# the VPS changes, the file still describes prod without an override.

	# DESIGN.md §6.1 — no CDN by default. DNS-only A record → VPS.
	# With no intermediary, the TCP peer IS the client IP and Caddy's
	# default (strip inbound X-Forwarded-*, set from the connection)
	# is exactly correct. No trusted_proxies needed.
	#
	# If a CDN is ever added, ALL THREE controls are required together:
	#   1. these directives
	#   2. origin firewall allowing :443 ONLY from the CDN CIDRs
	#   3. scheduled refresh of the CIDR list
	# Never 0.0.0.0/0 on a reachable origin.
}

# ── Public API ──────────────────────────────────────────────────────
{$CADDY_SCHEME:}{$API_DOMAIN} {
	encode zstd gzip

	# ── Public-surface enforcement (DESIGN.md §4.1, smoke A-14/A-15) ──
	# Default-deny management routes on the PUBLIC host. This is the edge
	# boundary that keeps /key/generate, /spend, /config, /team, etc. off the
	# internet while leaving them reachable on loopback and the portal's
	# internal URL (where `make key`, smoke A-8, and the portal actually use
	# them). LiteLLM publishes only on 127.0.0.1:4000, so a management route
	# can only become public by coming through THIS vhost — deny it here.
	# Ordered before the reverse_proxy so blocked paths never reach LiteLLM.
	@mgmt path /key/* /key /user/* /user /team/* /team /organization/* \
 /organization /model/* /model /spend/* /spend /config/* /config \
 /global/* /global /customer/* /customer /budget/* /budget
	respond @mgmt "Not found" 404

	request_body {
		max_size 10MB
	}

	# Strip headers a client could use to forge identity or routing.
	# LiteLLM reads Authorization and x-api-key interchangeably, so
	# clients can still use either style — we only remove the ones
	# that would let a caller assert a different identity or endpoint.
	header {
		-X-Forwarded-For
		-X-Real-IP
		-X-App-Id
		-Base-Url
		-Api-Base
		-Upstream-Url
	}

	# → auth-edge (127.0.0.1:4001), NOT litellm directly.
	#
	# Customers hold `zn-<body>`. LiteLLM only hashes credentials that start
	# with `sk-`, so the prefix is structural there, not cosmetic. The edge
	# restores it on this one path and forwards everything else untouched.
	# The ADMIN vhost below still goes straight to 4000: it speaks the master
	# key, not a customer key, and keeping it off the edge means the ops
	# console has one less hop to reason about.
	reverse_proxy {$AUTH_EDGE_UPSTREAM:127.0.0.1:4001} {
		# SSE. Low-latency mode: flush after every write.
		# Caddy also auto-detects text/event-stream and unknown
		# Content-Length, but this is set explicitly rather than
		# inferred — buffering is the single most common gateway bug.
		flush_interval -1

		# Long generations must not be cut off mid-stream.
		transport http {
			dial_timeout 10s

			# First-byte ceiling. 300s, not 120s: reasoning models
			# legitimately take 12–150s to first token (LATENCY.md §3.2).
			# A lower value converts slow thinking into a client-side
			# 502 and a wasted full-price upstream call.
			response_header_timeout 300s
			read_timeout 900s
			write_timeout 900s

			# Connection reuse. New TLS+TCP handshakes cost more than
			# the entire gateway overhead (LATENCY.md §10.2). Caddy
			# keep-alives to the upstream by default; these raise the
			# per-host idle pool for sustained concurrent streams.
			# (Client-facing keep-alive needs no config — it is on.)
			keepalive_interval 30s
			keepalive_idle_conns_per_host 64
		}
	}

	log {
		output stdout
		format json
	}

	# Per-request latency split, straight into the access log:
	#   up_lat_ms = Caddy → LiteLLM first-byte  (gateway + upstream wait)
	#   up_dur_ms = Caddy → LiteLLM total       (incl. full stream)
	# duration (built-in) − up_dur_ms ≈ Caddy's own cost.
	# Scrape these for the LATENCY.md §9 dashboard.
	log_append up_lat_ms {rp.upstream.latency_ms}
	log_append up_dur_ms {rp.upstream.duration_ms}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# ── Portal (customer dashboard) ─────────────────────────────────────
# Next.js, published on 127.0.0.1:3000 by the `portal` container and
# reachable here ONLY because caddy runs with host networking — see the
# network_mode comment in docker-compose.yml.
{$CADDY_SCHEME:}{$PORTAL_DOMAIN} {
	encode zstd gzip

	# D17 proof submissions carry an OPTIONAL screenshot. SCREENSHOT_MAX_BYTES
	# is 3MB (lib/billing/d17-config.ts) and the customer-facing copy in
	# three languages says "3 Mo maximum" — so a 2MB ceiling would answer 413
	# to a screenshot we told them to upload. 4MB = the 3MB cap plus
	# multipart framing, so an over-size upload is still refused by the
	# application with a readable error rather than by the edge.
	#
	# That 4MB lives in the matching `request_body` below, not in a `route`
	# here: an inner block would be dead config, for the reason stated there.
	# No separate proxy block is needed either — the vhost's own proxy
	# already flushes and already has a 4MB-capable body once the matcher
	# stops the blanket 2MB from running.

	# ── Request body ceilings: ONE per path, by matcher ───────────────
	# This used to be a blanket `request_body { max_size 2MB }` with a 4MB
	# carve-out nested inside its `route`. That carve-out was dead config.
	# Caddy's fixed directive order runs `request_body` BEFORE `route`, so
	# the blanket ceiling always executed first and the 413 always came from
	# it — the exception read like it worked and never could.
	#
	# Matchers make the exceptions real: exactly one ceiling applies to any
	# request, and it is chosen by path rather than by nesting.
	#
	#   2MB   the control-plane default. The portal takes JSON and form
	#         posts; a control plane that never handles model payloads
	#         should not be a file-drop endpoint.
	#   10MB  /api/chat only. A pasted stack trace or log is the product
	#         working. The handler's own per-message ceiling is 256KB and
	#         that is the check with the readable error, so this is the
	#         outer bound, not the product limit.
	#   4MB   /api/checkout/d17/proof only, per the note above.
	@bodyChat path /api/chat*
	@bodyProof path /api/checkout/d17/proof*
	@bodyDefault not path /api/chat* /api/checkout/d17/proof*

	request_body @bodyDefault {
		max_size 2MB
	}
	request_body @bodyChat {
		max_size 10MB
	}
	request_body @bodyProof {
		max_size 4MB
	}

	# ── Self-hosted desktop installers (/downloads/*) ─────────────────
	# Zaino AI Agent .dmg/.exe/.AppImage/.deb/.rpm live in
	# /opt/gateway/data/downloads/<version>/<file> on the host. Served
	# directly by Caddy — no Next.js hop, resumable range requests, and
	# Content-Disposition: attachment so browsers download instead of
	# trying to render a 100MB binary. The portal's /api/downloads route
	# lists what's actually on disk; this block serves the bytes.
	# Path traversal is impossible: `handle_path` strips the prefix then
	# `file_server` roots at the downloads dir, and Caddy cleans `..`
	# before resolving. The `hide` directive prevents serving dotfiles
	# and .sig sidecars, returning a standard 404 for them.
	handle_path /downloads/* {
		root * /opt/gateway/data/downloads
		header Content-Disposition "attachment"
		file_server browse {
			hide .* *.sig
		}
	}

	# ── Chat: the one streaming route on the portal ────────────────────
	# Every message the customer types reaches a model through /api/chat,
	# and the answer comes back as SSE. The rest of the control plane wants
	# the opposite — no streaming, short timeouts — so this path is carved
	# out rather than widening every route.
	#
	# `route` is terminal for a matched request, which is exactly the
	# intent: the 120s proxy below must never see a chat request.
	#
	# WHAT IS DELIBERATELY NOT HERE:
	#
	#   request_body        nothing to add here. @bodyChat above already
	#                       raises this path to 10MB, and the handler's own
	#                       256KB per-message check is the one with the
	#                       readable error — that pair is the ceiling, not
	#                       the 2MB default every other route keeps.
	#   header block        the vhost's runs first (Caddy orders `header`
	#                       before `route`), so repeating it here would be
	#                       dead config that reads like it does something.
	#
	#   300s header      the 60s default below turns a slow first token into
	#                    a 502 — the customer pays for a full generation and
	#                    sees an error (LATENCY.md §3.2: 12–150s);
	#   900s read/write  a long answer is still one request;
	#   flush_interval -1  without it every token arrives in one burst at
	#                    the end. That is the reason this block exists.
	route /api/chat* {
		reverse_proxy {$PORTAL_UPSTREAM:127.0.0.1:3000} {
			flush_interval -1
			transport http {
				dial_timeout 10s
				response_header_timeout 300s
				read_timeout 900s
				write_timeout 900s
				keepalive_interval 30s
				keepalive_idle_conns_per_host 64
			}
		}
	}

	reverse_proxy {$PORTAL_UPSTREAM:127.0.0.1:3000} {
		# Required by the Stripe webhook route: without it, Caddy may
		# buffer the request body and Stripe's signature check fails
		# intermittently — a bug that appears only under load and only on
		# the one endpoint that moves money.
		flush_interval -1

		# Short timeouts. Portal handlers wait on Postgres, LiteLLM REST,
		# and Stripe — never on a model generation. A portal request that
		# blocks for minutes is a bug, not a slow query.
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
			read_timeout 120s
			write_timeout 120s
			keepalive_interval 30s
			keepalive_idle_conns_per_host 64
		}
	}

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Browser access to `opencode web` (systemd unit `opencode-web`,
# loopback 127.0.0.1:4096, working dir /opt/gateway).
#
# WARNING: opencode web has NO built-in auth — this host is the entire
# security boundary. Default-deny, IP-gated like the admin host.
# Replace 203.0.113.4/32 102.159.152.165/32 with YOUR public IP (curl ifconfig.me) before
# first use. Requires DNS: code A <VPS_IP>.
{$CADDY_SCHEME:}{$CODE_DOMAIN} {
	# The allowlist is an env var with the production value as its default,
	# for the same reason as the upstreams at the top of this file: a
	# missing value would expand to an empty `remote_ip`, which is a syntax
	# error, and a hardcoded list cannot account for a local stack where
	# caddy sees the bridge gateway (172.x) rather than 127.0.0.1.
	#
	# Locally docker-compose.local.yml sets this to 0.0.0.0/0 so the vhost
	# is reachable at all. That is safe ONLY because code.localhost has no
	# upstream in that stack — the request 502s. It must never be relaxed
	# on a box where opencode-web is actually running: this vhost is that
	# service's entire security boundary (see the WARNING above).
	@blocked not remote_ip {$CODE_ALLOW:127.0.0.1/32 ::1 203.0.113.4/32 102.159.152.165/32}
	respond @blocked "Forbidden" 403

	reverse_proxy {$CODE_UPSTREAM:127.0.0.1:4096} {
		# Terminal UI streams over SSE + websockets (Caddy upgrades
		# automatically). Flush everything; no read/write timeout —
		# an idle coding session must not be killed mid-thought.
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
		}
	}

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
# ── Operations console (admin.zaino.soon.it) ────────────────────────
# The staff-facing Next.js console — suspend accounts, verify D17
# payments, read revenue and margin, manage plans and staff.
#
# A DIFFERENT VHOST FROM LiteLLM'S OWN ADMIN UI, DELIBERATELY.
#
# The retired ADMIN_DOMAIN variable used to point here and proxied to
# 127.0.0.1:4000, which is LiteLLM's Admin UI — a master-key-only surface
# listing raw keys and spend. It is a different product from the portal's
# operations console, it is far more powerful per request, and setting
# ADMIN_DOMAIN=admin.zaino.soon.it sent staff to LiteLLM while the
# console they actually needed stayed stranded on the portal domain.
#
# LiteLLM's management API is now reachable ONLY on 127.0.0.1:4000,
# which is already bound to loopback (docker-compose.yml publishes
# "127.0.0.1:4000:4000" and nothing else). There is no public vhost for
# it at all. Reach it with an SSH tunnel:
#
#     ssh -L 4000:localhost:4000 gateway@<VPS_IP>
#     # then http://localhost:4000/ui — master key required
#
# That is the same pattern already used for `opencode web` above. One
# leaked master key now requires shell access, not one HTTP request.
#
# This host is still IP-gated, because the portal's own staff gate is
# enforced in the application and the IP allowlist is defence in depth —
# it stops an unauthenticated caller from ever reaching a login form on
# the operations host.
#
# Replace 203.0.113.4/32 102.159.152.165/32 with YOUR public IP (curl -s ifconfig.me).
{$CADDY_SCHEME:}{$CONSOLE_DOMAIN} {
	# IP allowlist REMOVED: the admin gate secret (ADMIN_GATE_SECRET) is now
	# the sole access control. The gate page and /api/admin/gate route are
	# reachable from any IP; the HMAC-signed cookie minted by the correct
	# secret is what grants entry. This avoids the recurring 403 problem
	# when the operator's IP changes.

	# The same 2MB control-plane ceiling as the portal vhost, with the 4MB
	# D17-proof carve-out: staff open payment screenshots here and a proof
	# can be up to 3MB.
	#
	# By matcher, not by nesting, for exactly the reason the portal vhost
	# explains: `request_body` runs BEFORE `route` in Caddy's directive
	# order, so a carve-out nested inside a `route` never executes and the
	# blanket ceiling always wins.
	@consoleProof path /api/checkout/d17/proof*
	@consoleDefault not path /api/checkout/d17/proof*

	request_body @consoleDefault {
		max_size 2MB
	}
	request_body @consoleProof {
		max_size 4MB
	}

	# Redirect bare domain to the admin gate/console entry point.
	# Without this, / serves the portal's marketing landing page because
	# the reverse_proxy forwards to Next.js at /, which is the customer site.
	redir / /admin 302

	# Serve the admin gate as a static HTML file, bypassing Next.js entirely.
	# The Next.js root layout wraps /admin in theme CSS (bg-background) that
	# renders white-on-white. This static file has its own complete styling.
	# The gate JS checks the cookie client-side and redirects to /admin/ops.
	handle /admin {
		root * /etc/caddy
		try_files /admin-gate.html
		file_server
	}

	reverse_proxy {$PORTAL_UPSTREAM:127.0.0.1:3000} {
		flush_interval -1
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
			read_timeout 120s
			write_timeout 120s
			keepalive_interval 30s
			keepalive_idle_conns_per_host 64
		}
	}

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		# The console must never be indexed, and must never be embedded.
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
	}
}
